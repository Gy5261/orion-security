{
  "manifest_version": "2.0",
  "plugins": [
    {
      "capabilities": [
        "finding-normalization",
        "ticket-planning",
        "ticket-creation"
      ],
      "category": "automation-reporting",
      "default_timeout_seconds": 60,
      "description": "Convierte hallazgos en planes Jira/ServiceNow; la creación remota permanece bloqueada por el perfil controlado.",
      "homepage": null,
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "apply": {
            "type": "boolean"
          },
          "findings": {
            "items": {
              "type": "object"
            },
            "maxItems": 1000,
            "minItems": 1,
            "type": "array"
          },
          "mode": {
            "enum": [
              "plan",
              "jira",
              "servicenow"
            ],
            "type": "string"
          }
        },
        "required": [
          "findings"
        ],
        "type": "object"
      },
      "integration": "native",
      "license": null,
      "max_timeout_seconds": 600,
      "name": "Findings Ticket Sync",
      "network_access": false,
      "output_schema": {
        "properties": {
          "count": {
            "minimum": 0,
            "type": "integer"
          },
          "created": {
            "type": "array"
          },
          "items": {
            "type": "array"
          },
          "mode": {
            "type": "string"
          },
          "tool": {
            "enum": [
              "findings_ticket_sync"
            ],
            "type": "string"
          }
        },
        "required": [
          "tool",
          "mode",
          "count",
          "items"
        ],
        "type": "object"
      },
      "plugin_id": "findings_ticket_sync",
      "requires_authorization": true,
      "risk_level": "medium",
      "side_effects": true,
      "tags": [
        "jira",
        "servicenow",
        "reporting",
        "dry-run-default"
      ],
      "version": "1.0.0"
    },
    {
      "capabilities": [
        "ioc-classification",
        "dns-resolution",
        "threat-intelligence"
      ],
      "category": "osint-intelligence",
      "default_timeout_seconds": 30,
      "description": "Clasifica indicadores localmente; las consultas DNS y fuentes externas están bloqueadas por el perfil controlado.",
      "homepage": null,
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "external_sources": {
            "type": "boolean"
          },
          "iocs": {
            "items": {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 500,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "timeout": {
            "maximum": 30,
            "minimum": 0.1,
            "type": "number"
          },
          "workers": {
            "maximum": 32,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "iocs"
        ],
        "type": "object"
      },
      "integration": "native",
      "license": null,
      "max_timeout_seconds": 300,
      "name": "IOC Enricher",
      "network_access": true,
      "output_schema": {
        "properties": {
          "count": {
            "minimum": 0,
            "type": "integer"
          },
          "items": {
            "type": "array"
          },
          "tool": {
            "enum": [
              "ioc_enricher"
            ],
            "type": "string"
          }
        },
        "required": [
          "tool",
          "count",
          "items"
        ],
        "type": "object"
      },
      "plugin_id": "ioc_enricher",
      "requires_authorization": true,
      "risk_level": "low",
      "side_effects": false,
      "tags": [
        "ioc",
        "osint",
        "defensive",
        "json-first"
      ],
      "version": "1.0.0"
    },
    {
      "capabilities": [
        "domain-lookup",
        "email-lookup",
        "ip-lookup",
        "device-lookup"
      ],
      "category": "osint-aggregation",
      "default_timeout_seconds": 120,
      "description": "Runs the legacy OSINT-SPY public-data modes through a constrained adapter.",
      "homepage": "https://github.com/SharadKumar97/OSINT-SPY",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "target_type": {
            "enum": [
              "domain",
              "email",
              "ip",
              "device"
            ],
            "type": "string"
          },
          "timeout_seconds": {
            "maximum": 600,
            "minimum": 1,
            "type": "number"
          },
          "value": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "target_type",
          "value"
        ],
        "type": "object"
      },
      "integration": "subprocess",
      "license": "GPL-3.0",
      "max_timeout_seconds": 600,
      "name": "OSINT-SPY",
      "network_access": true,
      "output_schema": {
        "properties": {
          "artifacts": {
            "type": "object"
          },
          "execution": {
            "type": "object"
          },
          "result": {},
          "tool": {
            "type": "string"
          }
        },
        "required": [
          "tool",
          "result"
        ],
        "type": "object"
      },
      "plugin_id": "osint_spy",
      "requires_authorization": true,
      "risk_level": "medium",
      "side_effects": false,
      "tags": [
        "osint",
        "legacy",
        "external-adapter"
      ],
      "version": "1.0.0"
    },
    {
      "capabilities": [
        "phone-validation",
        "country-inference",
        "public-number-recon"
      ],
      "category": "osint-phone",
      "default_timeout_seconds": 120,
      "description": "Normalizes authorized PhoneInfoga scans of international telephone numbers.",
      "homepage": "https://github.com/sundowndev/phoneinfoga",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "number": {
            "pattern": "^\\+?[0-9 ()-]{6,32}$",
            "type": "string"
          },
          "timeout_seconds": {
            "maximum": 600,
            "minimum": 1,
            "type": "number"
          }
        },
        "required": [
          "number"
        ],
        "type": "object"
      },
      "integration": "subprocess",
      "license": "GPL-3.0",
      "max_timeout_seconds": 600,
      "name": "PhoneInfoga",
      "network_access": true,
      "output_schema": {
        "properties": {
          "artifacts": {
            "type": "object"
          },
          "execution": {
            "type": "object"
          },
          "result": {},
          "tool": {
            "type": "string"
          }
        },
        "required": [
          "tool",
          "result"
        ],
        "type": "object"
      },
      "plugin_id": "phoneinfoga",
      "requires_authorization": true,
      "risk_level": "medium",
      "side_effects": false,
      "tags": [
        "osint",
        "phone",
        "external-adapter"
      ],
      "version": "1.0.0"
    },
    {
      "capabilities": [
        "web-crawling",
        "url-extraction",
        "email-extraction",
        "file-discovery"
      ],
      "category": "osint-web",
      "default_timeout_seconds": 180,
      "description": "Crawls an authorized web target and normalizes public URLs, emails, files, and profiles.",
      "homepage": "https://github.com/s0md3v/Photon",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "delay": {
            "maximum": 30,
            "minimum": 0,
            "type": "number"
          },
          "depth": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer"
          },
          "only_urls": {
            "type": "boolean"
          },
          "request_timeout": {
            "maximum": 60,
            "minimum": 1,
            "type": "number"
          },
          "threads": {
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          },
          "timeout_seconds": {
            "maximum": 900,
            "minimum": 1,
            "type": "number"
          },
          "url": {
            "maxLength": 2048,
            "pattern": "^https?://",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "integration": "subprocess",
      "license": "GPL-3.0",
      "max_timeout_seconds": 900,
      "name": "Photon",
      "network_access": true,
      "output_schema": {
        "properties": {
          "artifacts": {
            "type": "object"
          },
          "execution": {
            "type": "object"
          },
          "result": {},
          "tool": {
            "type": "string"
          }
        },
        "required": [
          "tool",
          "result"
        ],
        "type": "object"
      },
      "plugin_id": "photon",
      "requires_authorization": true,
      "risk_level": "medium",
      "side_effects": false,
      "tags": [
        "osint",
        "crawler",
        "web",
        "external-adapter"
      ],
      "version": "1.0.0"
    },
    {
      "capabilities": [
        "username-enumeration",
        "public-profile-discovery"
      ],
      "category": "osint-identity",
      "default_timeout_seconds": 180,
      "description": "Checks public username presence across configured public services.",
      "homepage": "https://github.com/sherlock-project/sherlock",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "request_timeout": {
            "maximum": 60,
            "minimum": 1,
            "type": "number"
          },
          "sites": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 300,
            "type": "array",
            "uniqueItems": true
          },
          "timeout_seconds": {
            "maximum": 900,
            "minimum": 1,
            "type": "number"
          },
          "usernames": {
            "items": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "usernames"
        ],
        "type": "object"
      },
      "integration": "subprocess",
      "license": "MIT",
      "max_timeout_seconds": 900,
      "name": "Sherlock",
      "network_access": true,
      "output_schema": {
        "properties": {
          "artifacts": {
            "type": "object"
          },
          "execution": {
            "type": "object"
          },
          "result": {},
          "tool": {
            "type": "string"
          }
        },
        "required": [
          "tool",
          "result"
        ],
        "type": "object"
      },
      "plugin_id": "sherlock",
      "requires_authorization": true,
      "risk_level": "medium",
      "side_effects": false,
      "tags": [
        "osint",
        "username",
        "external-adapter"
      ],
      "version": "1.0.0"
    },
    {
      "capabilities": [
        "scan-start",
        "scan-list",
        "scan-results"
      ],
      "category": "osint-automation",
      "default_timeout_seconds": 60,
      "description": "Controls an authorized SpiderFoot service and returns normalized scan data.",
      "homepage": "https://github.com/smicallef/spiderfoot",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "modules": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 250,
            "type": "array",
            "uniqueItems": true
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "operation": {
            "enum": [
              "start",
              "list",
              "results",
              "summary"
            ],
            "type": "string"
          },
          "scan_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "server_url": {
            "maxLength": 2048,
            "pattern": "^https?://",
            "type": "string"
          },
          "target": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "timeout_seconds": {
            "maximum": 600,
            "minimum": 1,
            "type": "number"
          },
          "types": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 250,
            "type": "array",
            "uniqueItems": true
          },
          "use_case": {
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": [
          "operation"
        ],
        "type": "object"
      },
      "integration": "http-api",
      "license": "MIT",
      "max_timeout_seconds": 600,
      "name": "SpiderFoot",
      "network_access": true,
      "output_schema": {
        "properties": {
          "artifacts": {
            "type": "object"
          },
          "execution": {
            "type": "object"
          },
          "result": {},
          "tool": {
            "type": "string"
          }
        },
        "required": [
          "tool",
          "result"
        ],
        "type": "object"
      },
      "plugin_id": "spiderfoot",
      "requires_authorization": true,
      "risk_level": "medium",
      "side_effects": true,
      "tags": [
        "osint",
        "spiderfoot",
        "service-adapter",
        "read-mostly"
      ],
      "version": "1.0.0"
    },
    {
      "capabilities": [
        "email-discovery",
        "subdomain-discovery",
        "host-discovery"
      ],
      "category": "osint-reconnaissance",
      "default_timeout_seconds": 180,
      "description": "Collects public emails, hosts, and subdomains for an authorized domain.",
      "homepage": "https://github.com/laramies/theHarvester",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "dns_lookup": {
            "type": "boolean"
          },
          "domain": {
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9.-]+$",
            "type": "string"
          },
          "limit": {
            "maximum": 5000,
            "minimum": 1,
            "type": "integer"
          },
          "quiet": {
            "type": "boolean"
          },
          "sources": {
            "items": {
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "timeout_seconds": {
            "maximum": 900,
            "minimum": 1,
            "type": "number"
          }
        },
        "required": [
          "domain"
        ],
        "type": "object"
      },
      "integration": "subprocess",
      "license": "GPL-2.0-only",
      "max_timeout_seconds": 900,
      "name": "theHarvester",
      "network_access": true,
      "output_schema": {
        "properties": {
          "artifacts": {
            "type": "object"
          },
          "execution": {
            "type": "object"
          },
          "result": {},
          "tool": {
            "type": "string"
          }
        },
        "required": [
          "tool",
          "result"
        ],
        "type": "object"
      },
      "plugin_id": "theharvester",
      "requires_authorization": true,
      "risk_level": "medium",
      "side_effects": false,
      "tags": [
        "osint",
        "domain",
        "external-adapter"
      ],
      "version": "1.0.0"
    },
    {
      "capabilities": [
        "tls-inspection",
        "certificate-inventory"
      ],
      "category": "web-network",
      "default_timeout_seconds": 30,
      "description": "Inspecciona negociación TLS y certificados de endpoints autorizados.",
      "homepage": null,
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "targets": {
            "items": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 500,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "timeout": {
            "maximum": 30,
            "minimum": 0.1,
            "type": "number"
          },
          "workers": {
            "maximum": 32,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "targets"
        ],
        "type": "object"
      },
      "integration": "native",
      "license": null,
      "max_timeout_seconds": 300,
      "name": "TLS Posture Audit",
      "network_access": true,
      "output_schema": {
        "properties": {
          "count": {
            "minimum": 0,
            "type": "integer"
          },
          "items": {
            "type": "array"
          },
          "tool": {
            "enum": [
              "tls_posture_audit"
            ],
            "type": "string"
          }
        },
        "required": [
          "tool",
          "count",
          "items"
        ],
        "type": "object"
      },
      "plugin_id": "tls_posture_audit",
      "requires_authorization": true,
      "risk_level": "low",
      "side_effects": false,
      "tags": [
        "tls",
        "certificate",
        "defensive",
        "read-only"
      ],
      "version": "1.0.0"
    }
  ],
  "runtime": {
    "entry_point_group": "orion.plugins",
    "minimum_python": "3.10",
    "name": "orion-hacking-etico",
    "python_runtime": "not_recorded_static_catalog",
    "version": "2.1.1"
  }
}
