{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gy5261/orion-security/blob/main/skills/plugin.schema.json",
  "title": "ORION Plugin Manifest 2.0",
  "type": "object",
  "required": [
    "manifest_version",
    "runtime",
    "plugins"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "const": "2.0"
    },
    "runtime": {
      "type": "object",
      "required": [
        "name",
        "version",
        "python_runtime",
        "minimum_python",
        "entry_point_group"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "orion-hacking-etico"
        },
        "version": {
          "type": "string"
        },
        "python_runtime": {
          "type": "string"
        },
        "minimum_python": {
          "const": "3.10"
        },
        "entry_point_group": {
          "const": "orion.plugins"
        }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "plugin_id",
          "name",
          "version",
          "category",
          "description",
          "risk_level",
          "capabilities",
          "input_schema",
          "output_schema",
          "requires_authorization",
          "network_access",
          "side_effects",
          "default_timeout_seconds",
          "max_timeout_seconds",
          "tags",
          "integration"
        ],
        "additionalProperties": false,
        "properties": {
          "plugin_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "risk_level": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          },
          "requires_authorization": {
            "type": "boolean"
          },
          "network_access": {
            "type": "boolean"
          },
          "side_effects": {
            "type": "boolean"
          },
          "default_timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "max_timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "homepage": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "integration": {
            "enum": [
              "native",
              "subprocess",
              "http-api"
            ]
          }
        }
      }
    }
  }
}
